# URL del proyecto de Supabase (Project Settings > API > Project URL)
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"

# Clave pública "anon" de Supabase (Project Settings > API > anon public)
# Es segura para exponer en el frontend: el acceso real está controlado
# por las políticas de Row Level Security y las funciones RPC del proyecto.
SUPABASE_ANON_KEY="tu-anon-key-aqui"
